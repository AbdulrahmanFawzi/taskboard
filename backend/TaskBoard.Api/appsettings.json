{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "Provider": "Oracle", "OracleSqlCompatibility": "19", "ApplyMigrations": true },
  "Security": {
    "RequireTwoFactor": true,
    "AuthenticatorIssuer": "TaskBoard"
  }
}
