# Copy to .env.staging or .env.production on the server and fill in. Never commit the real files.

# Public host name. Point its DNS A record at the server first; Caddy then gets the certificate.
# For a quick test without a domain use  DOMAIN=:80  and SECURE_COOKIES=false (HTTP only, not for production).
DOMAIN=taskboard.example.com

# Staging or Production. Staging shows "(staging)" in authenticator apps so codes are not mixed up.
APP_ENV=Production
AUTHENTICATOR_ISSUER=TaskBoard
SECURE_COOKIES=true

# Oracle 19c. Ask the DBA for a dedicated schema user (see DEPLOY.md for the grants).
# Format: User Id=<user>;Password=<password>;Data Source=<host>:<port>/<service name>
ORACLE_CONNECTION=User Id=TASKBOARD;Password=change-me;Data Source=oracle.company.local:1521/ORCLPDB1

# true: the API creates and updates its tables on start (the user needs CREATE TABLE etc.).
# false: the DBA runs deploy/oracle/schema.sql before each release instead.
DB_APPLY_MIGRATIONS=true

# Where CI pushes the images, and which build to run.
REGISTRY=ghcr.io/your-org
TAG=latest

# Ports on the host. Leave 80/443 on a real server.
HTTP_PORT=80
HTTPS_PORT=443
